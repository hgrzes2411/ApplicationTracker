<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApplicationTracker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <nav class="sidebar-nav" aria-label="Główna nawigacja">
                <div class="brand-mark">
                    <span class="brand-icon"><i class="bi bi-briefcase-fill" aria-hidden="true"></i></span>
                    <span>Application<span class="brand-accent">Tracker</span></span>
                </div>

                <p class="nav-section-label">Workspace</p>
                <ul>
                    <li>
                        <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : null)"
                           asp-controller="Jobs" asp-action="Index">
                            <i class="bi bi-house-door" aria-hidden="true"></i><span>Start</span>
                        </a>
                    </li>
                    <li>
                        <a href="/dashboard">
                            <i class="bi bi-grid-1x2" aria-hidden="true"></i><span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Jobs" && ViewContext.RouteData.Values["action"]?.ToString() != "Index" ? "active" : null)"
                           asp-controller="Jobs" asp-action="Index">
                            <i class="bi bi-kanban" aria-hidden="true"></i><span>Aplikacje</span>
                        </a>
                    </li>
                </ul>

                <p class="nav-section-label">Działania</p>
                <ul>
                    <li>
                        <a asp-controller="Jobs" asp-action="Create">
                            <i class="bi bi-plus-circle" aria-hidden="true"></i><span>Dodaj aplikację</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <main class="app-main">
            <div class="content-shell">
                @RenderBody()
            </div>
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
