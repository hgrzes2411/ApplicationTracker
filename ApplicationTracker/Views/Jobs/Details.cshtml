@model JobApplication
@{
    ViewData["Title"] = "Szczegóły aplikacji";
}

<div class="page-header page-header-row">
    <h1>@Model.Company - @Model.Position</h1>
    <div>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edytuj</a>
        <a class="btn" asp-action="Delete" asp-route-id="@Model.Id">Usuń</a>
    </div>
</div>

<section class="section-card">
<dl>
    <dt>Lokalizacja</dt><dd>@Model.Location</dd>
    <dt>Tryb pracy</dt><dd>@Model.WorkMode</dd>
    <dt>Wynagrodzenie</dt><dd>@Model.SalaryRange</dd>
    <dt>Data aplikacji</dt><dd>@Model.ApplicationDate</dd>
    <dt>Źródło</dt><dd>@Model.Source</dd>
    <dt>Link</dt><dd><a href="@Model.Url" target="_blank" rel="noopener">@Model.Url</a></dd>
    <dt>Notatki</dt><dd>@Model.Notes</dd>
</dl>

<h2>Historia statusów</h2>
@if (Model.History.Any())
{
    <ul>
    @foreach (var history in Model.History.OrderBy(item => item.Date))
    {
        <li><strong>@history.Date</strong> - @history.Status @history.Note</li>
    }
    </ul>
}
else
{
    <p>Brak historii statusów.</p>
}
</section>
