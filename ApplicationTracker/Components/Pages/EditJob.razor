@page "/jobs/edit/{Id:guid}"

@rendermode InteractiveServer

@using ApplicationTracker.Models
@using ApplicationTracker.Services.Jobs

@inject JobService JobService
@inject NavigationManager Navigation


<PageTitle>Edycja aplikacji</PageTitle>

<h1>Edycja aplikacji</h1>

@if (job == null)
{
    <p>Ładowanie...</p>
}
else
{
    <h3>Historia statusów</h3>

    @if (job.History.Any())
    {
        <ul>
            @foreach (var item in job.History.OrderBy(x => x.Date))
            {
                <li>
                    @if (ReferenceEquals(editingStatus, item))
                    {
                        <InputSelect @bind-Value="editedStatus.Status">
                            @foreach (var status in Enum.GetValues<ApplicationStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>

                        <InputDate @bind-Value="editedStatus.Date" />
                        <InputText @bind-Value="editedStatus.Note"
                                   placeholder="Notatka (opcjonalnie)" />

                        <button type="button" @onclick="SaveStatusEdit">
                            Zapisz status
                        </button>
                        <button type="button" @onclick="CancelStatusEdit">
                            Anuluj
                        </button>
                    }
                    else
                    {
                        <span><strong>@item.Date</strong> - @item.Status</span>

                        @if (!string.IsNullOrWhiteSpace(item.Note))
                        {
                            <span> (@item.Note)</span>
                        }

                        <button type="button" @onclick="() => BeginStatusEdit(item)">
                            Edytuj
                        </button>
                        <button type="button"
                                disabled="@(job.History.Count <= 1)"
                                @onclick="() => RemoveStatus(item)">
                            Usuń
                        </button>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <p>Brak historii.</p>
    }

    @if (!string.IsNullOrWhiteSpace(statusValidationMessage))
    {
        <p class="validation-message">@statusValidationMessage</p>
    }


    <h4>Dodaj nowy status</h4>

    <InputSelect @bind-Value="newStatus.Status">
        @foreach (var status in Enum.GetValues<ApplicationStatus>())
        {
            <option value="@status">@status</option>
        }
    </InputSelect>

    <InputDate @bind-Value="newStatus.Date" />

    <InputText @bind-Value="newStatus.Note"
               placeholder="Notatka (opcjonalnie)" />

    <button type="button"
            @onclick="AddStatus">
        Dodaj status
    </button>


    <hr />


    <EditForm Model="job"
              FormName="EditJobForm"
              OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div>
            <label>Firma</label>
            <InputText @bind-Value="job.Company" />
            <ValidationMessage For="@(() => job.Company)" />
        </div>


        <div>
            <label>Stanowisko</label>
            <InputText @bind-Value="job.Position" />
            <ValidationMessage For="@(() => job.Position)" />
        </div>


        <div>
            <label>Lokalizacja</label>
            <InputText @bind-Value="job.Location" />
            <ValidationMessage For="@(() => job.Location)" />
        </div>


        <div>
            <label>Tryb pracy</label>

            <InputSelect @bind-Value="job.WorkMode">
                @foreach (var mode in Enum.GetValues<WorkMode>())
                {
                    <option value="@mode">
                        @mode
                    </option>
                }
            </InputSelect>
        </div>


        <div>
            <label>Widełki</label>

            <InputText @bind-Value="job.SalaryRange"
                       placeholder="np. 10 000–14 000 PLN" />
        </div>


        <div>
            <label>Link</label>

            <InputText @bind-Value="job.Url" />
            <ValidationMessage For="@(() => job.Url)" />
        </div>

        <div>
            <label>Notatki</label>

            <InputTextArea @bind-Value="job.Notes" />
        </div>


        <button type="submit">
            Zapisz zmiany
        </button>

    </EditForm>
}


@code {

    [Parameter]
    public Guid Id { get; set; }


    private JobApplication? job;


    private StatusHistory newStatus = new()
    {
        Date = DateOnly.FromDateTime(DateTime.Today)
    };

    private StatusHistory? editingStatus;
    private StatusHistory editedStatus = new();
    private string? statusValidationMessage;


    protected override async Task OnInitializedAsync()
    {
        var jobs = await JobService.GetAllAsync();

        job = jobs.FirstOrDefault(x => x.Id == Id);
    }


    private void AddStatus()
    {
        if (job == null)
        {
            return;
        }

        job.History.Add(new StatusHistory
        {
            Status = newStatus.Status,
            Date = newStatus.Date,
            Note = newStatus.Note
        });

        statusValidationMessage = null;

        newStatus = new StatusHistory
        {
            Date = DateOnly.FromDateTime(DateTime.Today)
        };
    }


    private void BeginStatusEdit(StatusHistory status)
    {
        editingStatus = status;
        editedStatus = new StatusHistory
        {
            Status = status.Status,
            Date = status.Date,
            Note = status.Note
        };
        statusValidationMessage = null;
    }


    private void SaveStatusEdit()
    {
        if (editingStatus == null)
        {
            return;
        }

        editingStatus.Status = editedStatus.Status;
        editingStatus.Date = editedStatus.Date;
        editingStatus.Note = editedStatus.Note;
        editingStatus = null;
        statusValidationMessage = null;
    }


    private void CancelStatusEdit()
    {
        editingStatus = null;
        statusValidationMessage = null;
    }


    private void RemoveStatus(StatusHistory status)
    {
        if (job == null || job.History.Count <= 1)
        {
            statusValidationMessage = "Aplikacja musi mieć co najmniej jeden status.";
            return;
        }

        job.History.Remove(status);
        statusValidationMessage = null;
    }


    private async Task Save()
    {
        if (job == null)
        {
            return;
        }

        if (job.History.Count == 0)
        {
            statusValidationMessage = "Aplikacja musi mieć co najmniej jeden status.";
            return;
        }

        job.History = job.History
            .OrderBy(x => x.Date)
            .ToList();

        await JobService.UpdateAsync(job);

        Navigation.NavigateTo("/jobs");
    }
}