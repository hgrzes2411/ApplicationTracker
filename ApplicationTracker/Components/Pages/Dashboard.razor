@page "/dashboard"

@rendermode InteractiveServer

@using ApplicationTracker.Models.Dashboard
@using ApplicationTracker.Services.Dashboard
@using ApplicationTracker.Components.Shared
@using ApplicationTracker.Components.Dashboard

@inject DashboardService DashboardService

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-container">

    @if (dashboard == null)
    {
        <LoadingSkeleton />
    }
    else
    {

        <DashboardSettingsPanel Settings="settings" />


        @if(settings.ShowSummary)
        {

            <div class="dashboard-header">

                <div class="dashboard-title">

                    <h1>
                        Application Tracker
                    </h1>

                    <p class="dashboard-subtitle">
                        @dashboard.WelcomeMessage
                    </p>

                </div>


                <div class="dashboard-overview">

                    <div>
                        <span class="overview-number">
                            @dashboard.Summary.TotalApplications
                        </span>

                        <span>
                            aplikacji
                        </span>
                    </div>


                    <div>
                        <span class="overview-number">
                            @dashboard.Summary.ActiveApplications
                        </span>

                        <span>
                            aktywnych procesów
                        </span>
                    </div>


                    <div>
                        <span class="overview-number">
                            @dashboard.Summary.OfferCount
                        </span>

                        <span>
                            ofert
                        </span>
                    </div>


                    <div>
                        <span class="overview-number">
                            @dashboard.Summary.GhostApplications
                        </span>

                        <span>
                            ghost jobs
                        </span>
                    </div>

                </div>


                <div class="dashboard-updated">

                    Ostatnia aktualizacja:
                    @dashboard.LastUpdated.ToString("dd.MM.yyyy HH:mm")

                </div>

            </div>



            <h2>Podsumowanie</h2>


            <div class="dashboard-grid">

                <StatCard Icon="📄"
                          Title="Aplikacje"
                          Value="@dashboard.Summary.TotalApplications.ToString()" />


                <StatCard Icon="🟢"
                          Title="Aktywne"
                          Value="@dashboard.Summary.ActiveApplications.ToString()" />


                <StatCard Icon="🤝"
                          Title="Interview"
                          Value="@dashboard.Summary.InterviewCount.ToString()" />


                <StatCard Icon="🏆"
                          Title="Oferty"
                          Value="@dashboard.Summary.OfferCount.ToString()" />


                <StatCard Icon="❌"
                          Title="Odrzucone"
                          Value="@dashboard.Summary.RejectedCount.ToString()" />


                <StatCard Icon="👻"
                          Title="Ghost Jobs"
                          Value="@dashboard.Summary.GhostApplications.ToString()" />

            </div>

        }



        @if(settings.ShowCharts)
        {

            <DashboardRow>


                @if(settings.ShowSuccessRate &&
                    dashboard.SuccessRate != null)
                {
                    <SuccessRate
                        Model="@dashboard.SuccessRate" />
                }


                @if(dashboard.StatusChart != null)
                {
                    <StatusChart
                        Data="@dashboard.StatusChart" />
                }


            </DashboardRow>



            <DashboardRow>


                @if(settings.ShowRecruitmentFunnel &&
                    dashboard.RecruitmentFunnel != null)
                {
                    <RecruitmentFunnel
                        Model="@dashboard.RecruitmentFunnel" />
                }


                @if(dashboard.Timeline != null)
                {
                    <RecruitmentTimeline
                        Model="@dashboard.Timeline" />
                }


            </DashboardRow>

        }



        @if(settings.ShowResponseAnalytics ||
            settings.ShowSourceAnalytics)
        {

            <DashboardRow>


                @if(settings.ShowResponseAnalytics &&
                    dashboard.ResponseAnalytics != null)
                {
                    <ResponseAnalytics
                        Model="@dashboard.ResponseAnalytics" />
                }


                @if(settings.ShowSourceAnalytics &&
                    dashboard.SourceAnalytics != null)
                {
                    <SourceAnalytics
                        Model="@dashboard.SourceAnalytics" />
                }


            </DashboardRow>

        }



        @if(settings.ShowCompanyAnalytics &&
            dashboard.CompanyAnalytics != null)
        {
            <CompanyAnalytics
                Model="@dashboard.CompanyAnalytics" />
        }



        @if(settings.ShowCompanyInsights &&
            dashboard.CompanyInsights != null)
        {
            <CompanyInsights
                Model="@dashboard.CompanyInsights" />
        }



        @if(settings.ShowRecommendations &&
            dashboard.Recommendations != null)
        {
            <RecommendationTable
                Model="@dashboard.Recommendations" />
        }



        @if(settings.ShowRecentActivity &&
            dashboard.RecentActivity != null)
        {
            <RecentActivity
                Model="@dashboard.RecentActivity" />
        }


    }

</div>


@code
{

    private DashboardModel? dashboard;


    private DashboardSettings settings = new();


    protected override async Task OnInitializedAsync()
    {

        dashboard = await DashboardService.GetDashboardAsync();

    }

}