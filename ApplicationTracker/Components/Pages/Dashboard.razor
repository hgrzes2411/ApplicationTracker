@page "/dashboard"

@rendermode InteractiveServer

@using ApplicationTracker.Models.Dashboard
@using ApplicationTracker.Services.Dashboard
@using ApplicationTracker.Components.Shared
@using ApplicationTracker.Components.Dashboard

@inject DashboardService DashboardService

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-container">

    @if (dashboard == null)
    {
        <LoadingSkeleton />
    }
    else
    {
        <div class="dashboard-header">

            <div>
                <div class="dashboard-title">

                    <h1>
                        Application Tracker
                    </h1>

                    <p class="dashboard-subtitle">

                        @dashboard.WelcomeMessage

                    </p>

                </div>

                <div class="dashboard-overview">

                    <div>

                        <span class="overview-number">

                            @dashboard.Summary.TotalApplications

                        </span>

                        <span>

                            aplikacji

                        </span>

                    </div>

                    <div>

                        <span class="overview-number">

                            @dashboard.Summary.ActiveApplications

                        </span>

                        <span>

                            aktywnych procesów

                        </span>

                    </div>

                    <div>

                        <span class="overview-number">

                            @dashboard.Summary.OfferCount

                        </span>

                        <span>

                            ofert

                        </span>

                    </div>

                    <div>

                        <span class="overview-number">

                            @dashboard.Summary.GhostApplications

                        </span>

                        <span>

                            ghost jobs

                        </span>

                    </div>

                </div>

                <div class="dashboard-updated">

                    Ostatnia aktualizacja:
                    @dashboard.LastUpdated.ToString("dd.MM.yyyy HH:mm")

                </div>
            </div>

        </div>

        <h2>Podsumowanie</h2>

        <div class="dashboard-grid">

            <StatCard Icon="📄"
                      Title="Aplikacje"
                      Value="@dashboard.Summary.TotalApplications.ToString()" />

            <StatCard Icon="🟢"
                      Title="Aktywne"
                      Value="@dashboard.Summary.ActiveApplications.ToString()" />

            <StatCard Icon="🤝"
                      Title="Interview"
                      Value="@dashboard.Summary.InterviewCount.ToString()" />

            <StatCard Icon="🏆"
                      Title="Oferty"
                      Value="@dashboard.Summary.OfferCount.ToString()" />

            <StatCard Icon="❌"
                      Title="Odrzucone"
                      Value="@dashboard.Summary.RejectedCount.ToString()" />

            <StatCard Icon="👻"
                      Title="Ghost Jobs"
                      Value="@dashboard.Summary.GhostApplications.ToString()" />

        </div>

        <DashboardRow>

            <SuccessRate
                Model="@dashboard.SuccessRate" />

            <StatusChart
                Data="@dashboard.StatusChart" />

        </DashboardRow>

        <DashboardRow>

            <RecruitmentFunnel
                Model="@dashboard.RecruitmentFunnel" />

            <RecruitmentTimeline
                Model="@dashboard.Timeline" />

        </DashboardRow>

        <DashboardRow>

            <ResponseAnalytics
                Model="@dashboard.ResponseAnalytics" />

            <SourceAnalytics
                Model="@dashboard.SourceAnalytics" />

        </DashboardRow>

        <CompanyAnalytics
            Model="@dashboard.CompanyAnalytics" />

        <CompanyInsights
            Model="@dashboard.CompanyInsights" />

        <RecommendationTable
            Model="@dashboard.Recommendations" />

        <RecentActivity
            Model="@dashboard.RecentActivity" />

    }

</div>

@code
{
    private DashboardModel? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await DashboardService.GetDashboardAsync();
    }
}