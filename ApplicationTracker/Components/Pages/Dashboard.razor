@page "/dashboard"

@rendermode InteractiveServer

@using ApplicationTracker.Models.Dashboard
@using ApplicationTracker.Services.Dashboard

@inject DashboardService DashboardService

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

@if (dashboard == null)
{
    <p>Ładowanie...</p>
}
else
{
    <h2>Podsumowanie</h2>

    <ul>
        <li>
            Łącznie aplikacji:
            @dashboard.Summary.TotalApplications
        </li>

        <li>
            Aktywne:
            @dashboard.Summary.ActiveApplications
        </li>

        <li>
            Interview:
            @dashboard.Summary.InterviewCount
        </li>

        <li>
            Oferty:
            @dashboard.Summary.OfferCount
        </li>

        <li>
            Odrzucone:
            @dashboard.Summary.RejectedCount
        </li>

        <li>
            Ghost Jobs:
            @dashboard.Summary.GhostApplications
        </li>
    </ul>


    <hr />


    <h2>Najbardziej podejrzane firmy</h2>

    @if (dashboard.CompanyAnalytics.TopCompanies != null &&
         dashboard.CompanyAnalytics.TopCompanies.Any())
    {
        <table>

            <thead>
                <tr>
                    <th>Firma</th>
                    <th>Aplikacje</th>
                    <th>Średni Ghost Score</th>
                    <th>Interview</th>
                    <th>Oferty</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var company in dashboard.CompanyAnalytics.TopCompanies.Take(10))
                {
                    <tr>
                        <td>@company.Company</td>

                        <td>@company.Applications</td>

                        <td>
                            @company.AverageGhostScore.ToString("F1")
                        </td>

                        <td>@company.InterviewCount</td>

                        <td>@company.OfferCount</td>
                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <p>Brak danych firm.</p>
    }


    <hr />


    <h2>Rekomendacje</h2>

    @if (dashboard.Recommendations != null &&
         dashboard.Recommendations.Items != null &&
         dashboard.Recommendations.Items.Any())
    {
        <table>

            <thead>
                <tr>
                    <th>Firma</th>
                    <th>Ghost Score</th>
                    <th>Poziom</th>
                    <th>Rekomendacja</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in dashboard.Recommendations.Items.Take(10))
                {
                    <tr>
                        <td>@item.Company</td>

                        <td>@item.GhostScore</td>

                        <td>@item.Level</td>

                        <td>@item.Message</td>
                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <p>Brak rekomendacji.</p>
    }


    <hr />


    <h2>⏱ Analityka odpowiedzi</h2>

    @if (dashboard.ResponseAnalytics != null)
    {
        <table>

            <thead>
                <tr>
                    <th>Średni czas odpowiedzi</th>
                    <th>Najszybsza odpowiedź</th>
                    <th>Najdłuższe oczekiwanie</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td>
                        @dashboard.ResponseAnalytics.AverageResponseTime.ToString("F1") dni
                    </td>

                    <td>
                        @dashboard.ResponseAnalytics.FastestResponseTime dni
                    </td>

                    <td>
                        @dashboard.ResponseAnalytics.SlowestResponseTime dni
                    </td>
                </tr>

            </tbody>

        </table>
    }
    else
    {
        <p>Brak danych o czasie odpowiedzi.</p>
    }


    <hr />


    <h2>🕒 Ostatnia aktywność</h2>

    @if (dashboard.RecentActivity != null &&
         dashboard.RecentActivity.Any())
    {
        <table>

            <thead>
                <tr>
                    <th>Data</th>
                    <th>Firma</th>
                    <th>Status</th>
                    <th>Notatka</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var activity in dashboard.RecentActivity)
                {
                    <tr>
                        <td>
                            @activity.Date
                        </td>

                        <td>
                            @activity.Company
                        </td>

                        <td>
                            @activity.Status
                        </td>

                        <td>
                            @activity.Note
                        </td>
                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <p>Brak aktywności.</p>
    }
}


@code
{
    private DashboardModel? dashboard;


    protected override async Task OnInitializedAsync()
    {
        dashboard = await DashboardService.GetDashboardAsync();
    }
}