@page "/dashboard"

@rendermode InteractiveServer

@using ApplicationTracker.Models.Dashboard
@using ApplicationTracker.Services.Dashboard
@using ApplicationTracker.Components.Shared
@using ApplicationTracker.Components.Dashboard

@inject DashboardService DashboardService

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-container">

    <div class="dashboard-header">

        <div>

            <h1>Application Tracker</h1>

            <p>
                Monitoruj proces rekrutacji oraz analizuj ryzyko ghostingu.
            </p>

        </div>

    </div>

    @if (dashboard == null)
    {
        <p>Ładowanie...</p>
    }
    else
    {
        <h2>Podsumowanie</h2>

        <div class="dashboard-grid">

            <StatCard Title="Aplikacje"
                      Value="@dashboard.Summary.TotalApplications.ToString()" />

            <StatCard Title="Aktywne"
                      Value="@dashboard.Summary.ActiveApplications.ToString()" />

            <StatCard Title="Interview"
                      Value="@dashboard.Summary.InterviewCount.ToString()" />

            <StatCard Title="Oferty"
                      Value="@dashboard.Summary.OfferCount.ToString()" />

            <StatCard Title="Odrzucone"
                      Value="@dashboard.Summary.RejectedCount.ToString()" />

            <StatCard Title="Ghost Jobs"
                      Value="@dashboard.Summary.GhostApplications.ToString()" />

        </div>

        <!-- Skuteczność rekrutacji -->

        <div class="section-card">

            <h2>🎯 Skuteczność rekrutacji</h2>

            <div class="success-rate-grid">

                <div class="success-item">
                    <span class="success-title">Aplikacje</span>
                    <span class="success-value">
                        @dashboard.SuccessRate.TotalApplications
                    </span>
                </div>

                <div class="success-item">
                    <span class="success-title">Odpowiedzi</span>
                    <span class="success-value">
                        @dashboard.SuccessRate.Responses
                    </span>
                </div>

                <div class="success-item">
                    <span class="success-title">Interview</span>
                    <span class="success-value">
                        @dashboard.SuccessRate.Interviews
                    </span>
                </div>

                <div class="success-item">
                    <span class="success-title">Oferty</span>
                    <span class="success-value">
                        @dashboard.SuccessRate.Offers
                    </span>
                </div>

            </div>

            <hr />

            <div class="success-rate-grid">

                <div class="success-item">
                    <span class="success-title">
                        Response Rate
                    </span>

                    <span class="success-percent">
                        @dashboard.SuccessRate.ResponseRate.ToString("F1")%
                    </span>
                </div>

                <div class="success-item">
                    <span class="success-title">
                        Interview Rate
                    </span>

                    <span class="success-percent">
                        @dashboard.SuccessRate.InterviewRate.ToString("F1")%
                    </span>
                </div>

                <div class="success-item">
                    <span class="success-title">
                        Offer Rate
                    </span>

                    <span class="success-percent">
                        @dashboard.SuccessRate.OfferRate.ToString("F1")%
                    </span>
                </div>

            </div>

        </div>

        <!-- Recruitment Funnel -->

        <RecruitmentFunnel Model="@dashboard.RecruitmentFunnel" />

        <!-- Wykres statusów -->

        <div class="section-card">

            <StatusChart Data="@dashboard.StatusChart" />

        </div>

        <!-- Pozostałe sekcje -->

        <div class="dashboard-two-columns">

            <CompanyAnalyticsSection Data="@dashboard.CompanyAnalytics" />

            <RecommendationsSection Data="@dashboard.Recommendations" />

            <ResponseAnalyticsSection Data="@dashboard.ResponseAnalytics" />

            <RecentActivitySection Data="@dashboard.RecentActivity" />

        </div>
    }

</div>

@code
{
    private DashboardModel? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await DashboardService.GetDashboardAsync();
    }
}