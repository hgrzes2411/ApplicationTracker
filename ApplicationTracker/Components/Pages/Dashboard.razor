
@page "/dashboard"

@rendermode InteractiveServer

@using ApplicationTracker.Models.Dashboard
@using ApplicationTracker.Services.Dashboard
@using ApplicationTracker.Components.Shared
@using ApplicationTracker.Components.Dashboard

@inject DashboardService DashboardService

<PageTitle>Dashboard | ApplicationTracker</PageTitle>

<div class="dashboard-container">

    @if (dashboard == null)
    {
        <div class="dashboard-loading">
            <LoadingSkeleton />
        </div>
    }
    else
    {
        <header class="dashboard-header dashboard-hero">
                <div class="dashboard-title">
                    <h1>
                        <span class="dashboard-brand-icon">🧑‍💻</span>
                        ApplicationTracker
                    </h1>
                </div>

                <div class="dashboard-updated">
                    <span>Ostatnia aktualizacja</span>
                    <strong>
                        @dashboard.LastUpdated.ToString("dd.MM.yyyy HH:mm")
                    </strong>
                </div>
            </header>

            <section class="dashboard-kpi-grid"
                     aria-label="Podsumowanie aplikacji">

                <div class="dashboard-kpi">
                    <StatCard Icon="📄"
                              Title="Aplikacje łącznie"
                              Value="@dashboard.Summary.TotalApplications.ToString()" />
                </div>

                <div class="dashboard-kpi dashboard-kpi-danger">
                    <StatCard Icon="🚩"
                              Title="Podejrzane ogłoszenia"
                              Value="@dashboard.Summary.GhostApplications.ToString()" />
                </div>

                <div class="dashboard-kpi dashboard-kpi-success">
                    <StatCard Icon="✅"
                              Title="Oferty"
                              Value="@dashboard.Summary.OfferCount.ToString()" />
                </div>
        </section>

        <section class="dashboard-section">
            <DashboardRow>
                <SuccessRate Model="@dashboard.SuccessRate" />

                <StatusChart Data="@dashboard.StatusChart" />
            </DashboardRow>
        </section>

        <section class="dashboard-section">
            <DashboardRow>
                <RecruitmentFunnel
                    Model="@dashboard.RecruitmentFunnel" />

                <RecruitmentTimeline
                    Model="@dashboard.Timeline" />
            </DashboardRow>
        </section>

        <section class="dashboard-section">
            <DashboardRow>
                <ResponseAnalytics
                    Model="@dashboard.ResponseAnalytics" />

                <SourceAnalytics
                    Model="@dashboard.SourceAnalytics" />
            </DashboardRow>
        </section>

        <section class="dashboard-section">
            <CompanyAnalytics
                Model="@dashboard.CompanyAnalytics" />
        </section>

        <section class="dashboard-section">
            <CompanyInsights
                Model="@dashboard.CompanyInsights" />
        </section>

        <section class="dashboard-section">
            <RecommendationTable
                Model="@dashboard.Recommendations" />
        </section>

        <section class="dashboard-section">
            <RecentActivity
                Model="@dashboard.RecentActivity" />
        </section>
    }
</div>

@code {
    private DashboardModel? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await DashboardService.GetDashboardAsync();
    }
}
