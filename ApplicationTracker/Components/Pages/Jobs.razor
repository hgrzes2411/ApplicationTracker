@page "/jobs"

@rendermode InteractiveServer

@using ApplicationTracker.Components.Jobs
@using ApplicationTracker.Models
@using ApplicationTracker.Models.Filters
@using ApplicationTracker.Models.Sorting
@using ApplicationTracker.Services.Export
@using ApplicationTracker.Services.GhostDetection
@using ApplicationTracker.Services.Jobs

@inject JobService JobService
@inject JobFilteringService JobFilteringService
@inject CsvExportService CsvExportService
@inject IJSRuntime JS
@inject GhostAnalysisCacheService GhostAnalysisCache

<PageTitle>Aplikacje</PageTitle>

<div class="page-header page-header-row">
    <div>
        <h1 class="page-title">Moje aplikacje</h1>
    </div>
    <a class="btn btn-primary" href="/jobs/add"><i class="bi bi-plus-lg" aria-hidden="true"></i> Dodaj aplikację</a>
</div>

<div class="mb-3">

    <button class="btn btn-primary"
            @onclick="ExportCsv">

        📤 Eksportuj CSV

    </button>

</div>

<JobFilters

    Filter="filter"

    Companies="Companies"

    Reset="ClearFilters"

    FilterChanged="FiltersChanged"

/>

@if (jobs == null)
{
    <p>Ładowanie...</p>
}
else if (!FilteredJobs.Any())
{
    <EmptyJobsState />
}
else
{
    <p class="results-counter">

        Wyświetlono

        <strong>@FilteredJobs.Count()</strong>

        z

        <strong>@jobs.Count</strong>

        aplikacji.

    </p>

    <JobsTable

        Jobs="FilteredJobs"

        GhostCache="GhostAnalysisCache"

        Delete="OpenDeleteDialog"

    />
}

<DeleteConfirmationDialog

    Visible="showDeleteDialog"

    Job="jobToDelete"

    OnConfirm="ConfirmDelete"

    OnCancel="CancelDelete"

/>
@code
{
    private List<JobApplication>? jobs;

    private JobFilter filter = new();

    private bool showDeleteDialog;

    private JobApplication? jobToDelete;

    private ApplicationStatus? selectedStatus
    {
        get => filter.Status;
        set => filter.Status = value;
    }

    private JobSortOption selectedSort
    {
        get => filter.SortOption;
        set => filter.SortOption = value;
    }

    private IEnumerable<JobApplication> FilteredJobs =>
        JobFilteringService.FilterJobs(
            jobs ?? Enumerable.Empty<JobApplication>(),
            filter);

    private IEnumerable<string> Companies =>
        jobs?
            .Select(j => j.Company)
            .Distinct()
            .OrderBy(c => c)
        ?? Enumerable.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        jobs = await JobService.GetAllAsync();
    }

    private void FiltersChanged()
    {
        StateHasChanged();
    }

    private void OpenDeleteDialog(JobApplication job)
    {
        jobToDelete = job;
        showDeleteDialog = true;
    }

    private void CancelDelete()
    {
        showDeleteDialog = false;
        jobToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (jobToDelete is null)
            return;

        await JobService.DeleteAsync(jobToDelete.Id);

        jobs = await JobService.GetAllAsync();

        showDeleteDialog = false;
        jobToDelete = null;
    }

    private async Task ExportCsv()
    {
        var allJobs = await JobService.GetAllAsync();

        var csv = CsvExportService.GenerateCsv(allJobs);

        await JS.InvokeVoidAsync(
            "downloadFile",
            $"applications_export_{DateTime.Now:yyyy-MM-dd}.csv",
            csv);
    }

    private void ClearFilters()
    {
        filter = new JobFilter
        {
            SortOption = JobSortOption.ApplicationDateDescending
        };
    }
}