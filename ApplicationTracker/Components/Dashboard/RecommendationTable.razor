@using ApplicationTracker.Components.Shared
@using ApplicationTracker.Models.Dashboard

<section class="section-card dashboard-risk-panel">

    <div class="dashboard-section-heading">
        <h2><span aria-hidden="true">🚩</span> Podejrzane wymuszki</h2>
        <span class="dashboard-section-caption">Ghost score i poziom ryzyka</span>
    </div>

    @if (Model.Items.Any())
    {
        <div class="table-wrapper">

            <table class="table">

                <thead>
                    <tr>
                        <th>Firma</th>
                        <th>Ghost Score</th>
                        <th>Ryzyko</th>
                        <th>Rekomendacja</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Items.Take(10))
                    {
                        <tr>

                            <td>@item.Company</td>

                            <td>@item.GhostScore</td>

                            <td>
                                <RiskBadge Score="item.GhostScore" />
                            </td>

                            <td>@item.Message</td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <EmptyState Title="Brak rekomendacji"
                    Description="Dodaj więcej aplikacji." />
    }

</section>

@code
{
    [Parameter]
    public RecommendationDashboardModel Model { get; set; } = new();
}