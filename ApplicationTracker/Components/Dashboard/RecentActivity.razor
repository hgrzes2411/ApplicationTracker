@using ApplicationTracker.Models.Dashboard

<div class="section-card">

    <h2>🕒 Ostatnia aktywność</h2>

    @if (Model.Any())
    {
        <table class="table">

            <thead>
                <tr>
                    <th>Data</th>
                    <th>Firma</th>
                    <th>Status</th>
                    <th>Notatka</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var activity in Model)
                {
                    <tr>
                        <td>@activity.Date</td>
                        <td>@activity.Company</td>
                        <td>@activity.Status</td>
                        <td>@activity.Note</td>
                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <p>Brak aktywności.</p>
    }

</div>

@code
{
    [Parameter]
    public List<ActivityDashboardModel> Model { get; set; } = [];
}