@using ApplicationTracker.Models.Dashboard
@using ApplicationTracker.Components.Shared

<SectionCard Title="🕒 Ostatnia aktywność">

    @if (Data.Any())
    {
        <table>

            <thead>
                <tr>
                    <th>Data</th>
                    <th>Firma</th>
                    <th>Status</th>
                    <th>Notatka</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var activity in Data)
                {
                    <tr>

                        <td>@activity.Date</td>

                        <td>@activity.Company</td>

                        <td>
                            <StatusBadge Status="@activity.Status" />
                        </td>

                        <td>@activity.Note</td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <p>Brak aktywności.</p>
    }

</SectionCard>

@code
{
    [Parameter]
    public List<ActivityDashboardModel> Data { get; set; } = [];
}