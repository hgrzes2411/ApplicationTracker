@using ApplicationTracker.Models.Dashboard

<div class="section-card">

    <h2>Company Insights</h2>

    @if (Model.Companies.Any())
    {
        <table class="table-wrapper">

            <thead>
                <tr>
                    <th>Firma</th>
                    <th>Aplikacje</th>
                    <th>Interview</th>
                    <th>Oferty</th>
                    <th>Success</th>
                    <th>Ghost</th>
                    <th>Response</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var company in Model.Companies)
                {
                    <tr>

                        <td>@company.Company</td>

                        <td>@company.Applications</td>

                        <td>@company.InterviewCount</td>

                        <td>@company.OfferCount</td>

                        <td>@company.SuccessRate.ToString("F1")%</td>

                        <td>@company.AverageGhostScore.ToString("F1")</td>

                        <td>@company.AverageResponseTime.ToString("F1") dni</td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <p>Brak danych.</p>
    }

</div>

@code
{
    [Parameter]
    public CompanyInsightsModel Model { get; set; } = new();
}