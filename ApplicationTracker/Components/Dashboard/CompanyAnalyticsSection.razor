@using ApplicationTracker.Models.Dashboard


<div class="section-card">

    <h2>Najbardziej podejrzane firmy</h2>

    @if (Data.TopCompanies.Any())
    {
        <table class="table-wrapper">

            <thead>
                <tr>
                    <th>Firma</th>
                    <th>Aplikacje</th>
                    <th>Średni Ghost Score</th>
                    <th>Interview</th>
                    <th>Oferty</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var company in Data.TopCompanies.Take(10))
                {
                    <tr>

                        <td>@company.Company</td>

                        <td>@company.Applications</td>

                        <td>
                            @company.AverageGhostScore.ToString("F1")
                        </td>

                        <td>
                            @company.InterviewCount
                        </td>

                        <td>
                            @company.OfferCount
                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <p>Brak danych firm.</p>
    }

</div>

@code
{
    [Parameter]
    public CompanyAnalyticsDashboardModel Data { get; set; } = new();
}