@using ApplicationTracker.Components.Shared
@using ApplicationTracker.Models.Dashboard

<div class="section-card">

    <h2>Najbardziej podejrzane firmy</h2>

    @if (Data.TopCompanies.Any())
    {
        <table class="table-wrapper">

            <thead>
                <tr>
                    <th @onclick='() => SortBy(nameof(CompanyDashboardModel.Company))'>
                        Firma @SortIndicator(nameof(CompanyDashboardModel.Company))
                    </th>

                    <th @onclick='() => SortBy(nameof(CompanyDashboardModel.Applications))'>
                        Aplikacje @SortIndicator(nameof(CompanyDashboardModel.Applications))
                    </th>

                    <th @onclick='() => SortBy(nameof(CompanyDashboardModel.AverageGhostScore))'>
                        Średni Ghost Score @SortIndicator(nameof(CompanyDashboardModel.AverageGhostScore))
                    </th>

                    <th @onclick='() => SortBy(nameof(CompanyDashboardModel.InterviewCount))'>
                        Interview @SortIndicator(nameof(CompanyDashboardModel.InterviewCount))
                    </th>

                    <th @onclick='() => SortBy(nameof(CompanyDashboardModel.OfferCount))'>
                        Oferty @SortIndicator(nameof(CompanyDashboardModel.OfferCount))
                    </th>

                </tr>
            </thead>

            <tbody>

                @foreach (var company in SortedCompanies.Take(10))
                {
                    <tr>

                        <td>@company.Company</td>

                        <td>@company.Applications</td>

                        <td>@company.AverageGhostScore.ToString("F1")</td>

                        <td>@company.InterviewCount</td>

                        <td>@company.OfferCount</td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <EmptyState Title="Brak danych"
                    Description="Nie znaleziono żadnych firm." />
    }

</div>

@code
{
    [Parameter]
    public CompanyAnalyticsDashboardModel Data { get; set; } = new();

    private string sortColumn = nameof(CompanyDashboardModel.AverageGhostScore);

    private bool ascending = false;

    private IEnumerable<CompanyDashboardModel> SortedCompanies =>
        sortColumn switch
        {
            nameof(CompanyDashboardModel.Company) =>
                ascending
                    ? Data.TopCompanies.OrderBy(x => x.Company)
                    : Data.TopCompanies.OrderByDescending(x => x.Company),

            nameof(CompanyDashboardModel.Applications) =>
                ascending
                    ? Data.TopCompanies.OrderBy(x => x.Applications)
                    : Data.TopCompanies.OrderByDescending(x => x.Applications),

            nameof(CompanyDashboardModel.AverageGhostScore) =>
                ascending
                    ? Data.TopCompanies.OrderBy(x => x.AverageGhostScore)
                    : Data.TopCompanies.OrderByDescending(x => x.AverageGhostScore),

            nameof(CompanyDashboardModel.InterviewCount) =>
                ascending
                    ? Data.TopCompanies.OrderBy(x => x.InterviewCount)
                    : Data.TopCompanies.OrderByDescending(x => x.InterviewCount),

            nameof(CompanyDashboardModel.OfferCount) =>
                ascending
                    ? Data.TopCompanies.OrderBy(x => x.OfferCount)
                    : Data.TopCompanies.OrderByDescending(x => x.OfferCount),

            _ => Data.TopCompanies
        };

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            ascending = !ascending;
        }
        else
        {
            sortColumn = column;
            ascending = true;
        }
    }

    private string SortIndicator(string column)
    {
        if (sortColumn != column)
            return "";

        return ascending ? "▲" : "▼";
    }
}