@using ApplicationTracker.Models

@if (Visible)
{
    <div class="success-notification delete-notification" role="alert" aria-live="assertive">
        <div class="success-notification-icon" aria-hidden="true">!</div>
        <div class="delete-notification-content">
            <strong>Potwierdzenie usunięcia</strong>
            @if (Job != null)
            {
                <p>Czy na pewno chcesz usunąć aplikację do firmy <strong>@Job.Company</strong> na stanowisko <strong>@Job.Position</strong>?</p>
            }
            else
            {
                <p>Czy na pewno chcesz usunąć tę aplikację?</p>
            }
            <div class="delete-notification-actions">
                <button class="btn btn-secondary" type="button" @onclick="OnCancelClicked">Anuluj</button>
                <button class="btn btn-danger" type="button" @onclick="OnConfirmClicked">Usuń</button>
            </div>
        </div>
        <button class="success-notification-close" type="button" aria-label="Zamknij komunikat" @onclick="OnCancelClicked">×</button>
    </div>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public JobApplication? Job { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task OnConfirmClicked()
    {
        await OnConfirm.InvokeAsync();
    }

    private async Task OnCancelClicked()
    {
        await OnCancel.InvokeAsync();
    }
}
